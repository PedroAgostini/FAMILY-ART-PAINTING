# ==========================================================================
# Family Art Painting | Apache configuration
# Test environment: https://family.escolats.com.br/
# ==========================================================================

Options -Indexes -MultiViews
DirectoryIndex index.html
ErrorDocument 404 /404.html
ServerSignature Off
AddDefaultCharset utf-8

# --------------------------------------------------------------------------
# MIME types
# --------------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType application/manifest+json   webmanifest
  AddType image/webp                  webp
  AddType image/avif                  avif
  AddType image/svg+xml               svg svgz
  AddType image/x-icon                ico
  AddType font/woff2                  woff2
  AddType font/woff                   woff
  AddType text/javascript             js mjs
  AddType application/xml             xml
  AddCharset utf-8 .html .css .js .mjs .json .webmanifest .xml .txt .svg
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # ------------------------------------------------------------------------
  # HTTPS and no www (works behind proxies that set X-Forwarded-Proto)
  # ------------------------------------------------------------------------
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # ------------------------------------------------------------------------
  # Private files and folders: answer 404 as if they did not exist
  # ------------------------------------------------------------------------
  RewriteRule (^|/)\.(?!well-known/) - [R=404,L]
  RewriteRule ^(Logos|tools|docs|node_modules|images/_originais)(/|$) - [R=404,L]
  RewriteRule \.(md|log|bak|old|orig|sql|sh|ini|env|lock|psd|ai|zip)$ - [R=404,L,NC]
  RewriteRule \.(webp|png|jpe?g|svg|gif)\.json$ - [R=404,L,NC]
  RewriteRule ^(package(-lock)?\.json|composer\.(json|lock))$ - [R=404,L,NC]

  # ------------------------------------------------------------------------
  # Antispam: refuse known e-mail harvesters and scraping tools
  # ------------------------------------------------------------------------
  RewriteCond %{HTTP_USER_AGENT} (EmailCollector|EmailSiphon|EmailWolf|ExtractorPro|WebEMailExtrac|EmailHarvest|Harvest|CherryPicker|WebBandit|WebStripper|HTTrack|Zeus|grub-client|libwww-perl|Java/1\.|python-requests|Go-http-client) [NC]
  RewriteRule ^ - [F,L]
  # Empty user agent on anything but the home page
  RewriteCond %{HTTP_USER_AGENT} ^-?$
  RewriteCond %{REQUEST_URI} !^/$
  RewriteRule ^ - [F,L]

  # ------------------------------------------------------------------------
  # Test environment: its own robots.txt (blocks crawlers)
  # ------------------------------------------------------------------------
  RewriteCond %{HTTP_HOST} escolats\.com\.br$ [NC]
  RewriteRule ^robots\.txt$ robots-staging.txt [L]

  # ------------------------------------------------------------------------
  # Clean URLs: never show .html
  # ------------------------------------------------------------------------
  # /index.html and /index  ->  /
  RewriteCond %{THE_REQUEST} \s/+(.*/)?index(\.html)?[\s?] [NC]
  RewriteRule ^(.*/)?index(\.html)?$ /%1 [R=301,L,NC]

  # /page.html  ->  /page
  RewriteCond %{THE_REQUEST} \s/+([^\s?]+?)\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L,NE]

  # /page/  ->  /page (when it is not a real folder)
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # /page  ->  serves page.html internally
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>

# Old Apache without mod_rewrite: still keep the private files private
<IfModule !mod_rewrite.c>
  <FilesMatch "\.(md|log|bak|sql|sh|ini|env|lock|json)$">
    Require all denied
  </FilesMatch>
</IfModule>
<FilesMatch "^(\.htaccess|\.htpasswd|\.env.*|\.git.*)$">
  Require all denied
</FilesMatch>

# --------------------------------------------------------------------------
# Security headers
# --------------------------------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Strict-Transport-Security "max-age=31536000" "expr=%{HTTPS} == 'on' || %{HTTP:X-Forwarded-Proto} == 'https'"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://cdn.jsdelivr.net 'sha256-/x7W7R75k8Roq0WaVRQX9blP4OufE5xbAdzklGxsgpw='; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https://cdn.jsdelivr.net https://formspree.io; frame-src https://www.google.com https://maps.google.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self' https://formspree.io mailto:; frame-ancestors 'self'; upgrade-insecure-requests"
  Header unset X-Powered-By
  Header always unset X-Powered-By

  # Test environment stays out of search engines
  <If "%{HTTP_HOST} =~ /escolats\.com\.br$/">
    Header always set X-Robots-Tag "noindex, nofollow"
  </If>
</IfModule>

# --------------------------------------------------------------------------
# Compression
# --------------------------------------------------------------------------
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/plain text/xml text/javascript application/javascript application/json application/manifest+json application/xml image/svg+xml image/x-icon font/ttf
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml text/javascript application/javascript application/json application/manifest+json application/xml image/svg+xml image/x-icon font/ttf
</IfModule>

# --------------------------------------------------------------------------
# Cache
# HTML is always revalidated, so a new upload shows at once.
# CSS and JS are versioned (?v=) in index.html: bump the version to clear
# every visitor's cache (node tools/cache-bust.mjs).
# --------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                          "access plus 1 month"
  ExpiresByType text/html                 "access plus 0 seconds"
  ExpiresByType application/xml           "access plus 1 day"
  ExpiresByType text/xml                  "access plus 1 day"
  ExpiresByType text/plain                "access plus 1 day"
  ExpiresByType application/manifest+json "access plus 1 week"
  ExpiresByType text/css                  "access plus 1 year"
  ExpiresByType text/javascript           "access plus 1 year"
  ExpiresByType application/javascript    "access plus 1 year"
  ExpiresByType font/woff2                "access plus 1 year"
  ExpiresByType image/webp                "access plus 1 month"
  ExpiresByType image/png                 "access plus 1 month"
  ExpiresByType image/jpeg                "access plus 1 month"
  ExpiresByType image/svg+xml             "access plus 1 month"
  ExpiresByType image/x-icon              "access plus 1 month"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(css|js|mjs|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(webp|png|jpe?g|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(xml|txt|webmanifest)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
  # Fonts are preloaded with crossorigin
  <FilesMatch "\.woff2$">
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>
  Header unset ETag
</IfModule>
FileETag None
